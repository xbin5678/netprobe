# 仓库内统一 LF，避免在 Linux 上跑 .sh 时报 $'\r': command not found
* text=auto

*.sh      text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.json    text eol=lf
Caddyfile text eol=lf

# Windows 批处理必须是 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.ico     binary
*.exe     binary
*.db      binary
